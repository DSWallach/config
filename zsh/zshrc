# cofactr-workspace: wsg PATH stickiness + tab completions (scripts/setup.sh; see README)
# Optional: export COFACTR_WORKSPACE_ZSHRC=/path/to/workspace so wsg_* and completions work before cd / beat direnv.
_cofactr_wsg_precmd() {
  local _bin
  if [[ -n "${COFACTR_WORKSPACE_ZSHRC:-}" && -d "${COFACTR_WORKSPACE_ZSHRC}/scripts/shell/bin" ]]; then
    _bin="${COFACTR_WORKSPACE_ZSHRC}/scripts/shell/bin"
    path=($_bin ${(@)path:#$_bin})
    export WSG_ZSH="$COFACTR_WORKSPACE_ZSHRC/scripts/shell/wsg.zsh"
    export WSG_WORKSPACE_ROOT="$COFACTR_WORKSPACE_ZSHRC"
  fi
  [[ -n ${WSG_ZSH:-} ]] || return 0
  local _reg="${WSG_ZSH:A:h}/zsh/register-wsg-completions.zsh"
  [[ -r $_reg ]] || return 0
  source "$_reg"
}
