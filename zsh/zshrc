# Lazy nvm: sourcing nvm.sh runs `nvm use default`, which is very slow with an lts/* default.
# The newest installed node stays on PATH so non-interactive callers still find it.
_nvm_default_bin=(${NVM_DIR}/versions/node/*(N/on[-1]))
[[ -n $_nvm_default_bin ]] && path=("${_nvm_default_bin[1]}/bin" $path)
unset _nvm_default_bin

_nvm_lazy_load() {
  unset -f nvm node npm npx _nvm_lazy_load
  [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh" --no-use
  [ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"
}
nvm() { _nvm_lazy_load; nvm "$@"; }
node() { _nvm_lazy_load; node "$@"; }
npm() { _nvm_lazy_load; npm "$@"; }
npx() { _nvm_lazy_load; npx "$@"; }


