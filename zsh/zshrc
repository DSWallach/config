function eslint-ui-main() {
  local root="${COFACTR_UI:-$(git rev-parse --show-toplevel 2>/dev/null)}"
  [[ -n "$root" ]] || { echo 'eslint-ui-main: not inside a git repo'; return 1; }
  local base
  if git -C "$root" show-ref --verify --quiet refs/remotes/origin/main 2>/dev/null; then
    base=origin/main
  elif git -C "$root" show-ref --verify --quiet refs/remotes/origin/master 2>/dev/null; then
    base=origin/master
  elif git -C "$root" show-ref --verify --quiet refs/heads/main 2>/dev/null; then
    base=main
  elif git -C "$root" show-ref --verify --quiet refs/heads/master 2>/dev/null; then
    base=master
  else
    echo 'eslint-ui-main: no main/master (git fetch origin?)'
    return 1
  fi
  local files
  files=$(git -C "$root" diff --name-only --diff-filter=ACM "${base}...HEAD" -- . | grep -E '\.(tsx?|jsx?)$')
  [[ -n "$files" ]] || { echo "eslint-ui-main: no matching changes vs ${base}"; return 0; }
  (cd "$root" && ui-lint $files)
}
