# set your user tokens as environment variables, such as ~/.secrets
# See the README for examples.
[core]
  editor = vim
	autocrlf = input
[color]
  ui = true
[color "branch"]
  current = yellow reverse
  local = yellow
  remote = green
[color "diff"]
  meta = yellow bold
  frag = magenta bold
  old = red
  new = green
[alias]
  # add
  a = add                           # add

  # branch
  b = branch -v                     # branch (verbose)

  # commit
  c = commit -m                     # commit with message
  amend = commit --amend            # ammend your last commit
  ammend = commit --amend           # ammend your last commit

  # checkout
  co = checkout                     # checkout
  nb = "!f() { git checkout -b \"$1\" && git config branch.\"$1\".remote origin && git config branch.\"$1\".merge \"refs/heads/$1\"; }; f"  # create and switch to a new branch tracking origin/<same-name> (mnemonic: "git new branch branchname...")

  # diff
  d = diff                          # diff unstaged changes
  dc = diff --cached                # diff staged changes
  last = diff HEAD^                 # diff last committed change

  # log
  l = log --graph --date=short

  # pull
  pl = pull                         # pull

  # push
  ps = push                         # push

  # remote
  r = remote -v                     # show remotes (verbose)

  # status
  s = status                        # status

[include]
  path = .gitconfig.user
[user]
	name = David Wallach
	email = d.s.t.wallach@gmail.com
[push]
	default = current
[github]
	user = dswallach
[credential]
	helper = cache
[pull]
	base = false
	rebase = false
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
